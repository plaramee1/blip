# ~/.config/blip-triage/env — chmod 600. Never commit the real file.

# Fine-grained personal access token: repository access plaramee1/blip only,
# permission Issues: Read and write. Nothing else.
GH_TOKEN=github_pat_REPLACE_ME

# Ollama model (default gpt-oss:20b). qwen3:14b also works; it thinks first.
TRIAGE_MODEL=gpt-oss:20b
# OLLAMA_URL=http://localhost:11434
# TRIAGE_DAILY_LIMIT=40

# Optional: mirror issues labelled `accepted` to a private tracker. Inert
# unless both are set. Fine-grained token, that repository only, Issues: Read
# and write, Contents: Read (Contents is for the "Fixed in vX.Y" comment).
# MIRROR_TOKEN=github_pat_REPLACE_ME
# MIRROR_REPO=owner/name
# Post "Fixed in vX.Y" from a private release while no public release has the tag.
# FIXED_ALLOW_PRIVATE=1
